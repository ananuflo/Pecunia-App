<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_medio">

    <ImageButton
        android:id="@+id/btnVolverRetirada"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1B5E20" />

    <TextView
        android:id="@+id/tvTituloCajeros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/anton"
        android:text="BUSCADOR DE CAJEROS 👑"
        android:textColor="#B8860B"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardBackgroundColor="#FFFFFF"  app:cardCornerRadius="15dp"
        app:cardElevation="8dp" app:layout_constraintBottom_toTopOf="@+id/btnMapaGeneral"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCajeros">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvEstadoBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Buscando cajeros..."
                android:textColor="#000000" android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnMapaGeneral"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="🌍 VER TODOS EN GOOGLE MAPS"
        android:textColor="#1B5E20"
        app:layout_constraintBottom_toTopOf="@+id/btnIrAFormularioRetirada"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnIrAFormularioRetirada"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="30dp"
        android:background="@drawable/boton_cuadrado"
        android:fontFamily="@font/bakbak_one"
        android:text="REGISTRAR RETIRADA"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>