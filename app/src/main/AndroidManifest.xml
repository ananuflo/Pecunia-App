<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.pecunia">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/cerditoverde"
        android:label="@string/app_name"
        android:roundIcon="@drawable/cerditoverde"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pecunia">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/cerditoverde" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@android:color/black" />

        <activity
            android:name=".activities.auth.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.auth.Inicio" android:exported="false" />
        <activity android:name=".activities.auth.Entrar" android:exported="false" />
        <activity android:name=".activities.auth.Registro" android:exported="false" />

        <activity android:name=".activities.main.MainActivity" android:exported="false" />
        <activity android:name=".activities.main.Ingreso" android:exported="false" />
        <activity android:name=".activities.main.Gasto" android:exported="false" />

        <activity android:name=".activities.reports.Resumen" android:exported="false" />
        <activity android:name=".activities.reports.ResumenBasico" android:exported="false" />
        <activity android:name=".activities.reports.ResumenClasificado" android:exported="false" />
        <activity android:name=".activities.reports.GastoClasificado" android:exported="false" />

        <activity android:name=".activities.forms.FormularioGasto" android:exported="false" />
        <activity android:name=".activities.forms.FormularioIngreso" android:exported="false" />

        <activity android:name=".data.network.RetiradaEfectivo" android:exported="false" />

        <activity android:name=".activities.main.PerfilActivity" />
        <service
            android:name=".activities.notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>
